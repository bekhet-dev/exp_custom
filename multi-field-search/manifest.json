{
  "name": "multi-field-search",
  "label": "Multi Field Search",
  "type": "widget",
  "version": "1.0.0",
  "exbVersion": "1.15.0",
  "author": "Bekhet",
  "description": "A custom widget that allows searching across multiple fields in a selected layer and displays results in a list.",
  "license": "http://www.apache.org/licenses/LICENSE-2.0",
  "properties": {
    "hasSettingPage": true,
    "hasConfig": true
  },
  "useDataSources": true,
  "isDataSourceOptional": false,
  "runtime": {
    "hasUI": true
  },
  "publishMessages": [
    "DATA_RECORDS_SELECTION_CHANGE"
  ],
  "supportedDataSourceTypes": [
    "FeatureLayer",
    "SceneLayer"
  ],
  "settingPanel": {
    "hasCustomSetting": true,
    "widgetSettingPage": true
  },
  "translatedLocales": [
    "en"
  ],
  "defaultSize": {
    "width": 400,
    "height": 500
  }
}